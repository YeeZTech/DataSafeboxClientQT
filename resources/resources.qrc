<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/">
        <!-- Entry Point -->
        <file alias="main.qml">../qml/main.qml</file>
        <file alias="qmldir">../qml/qmldir</file>

        <!-- Theme (singletons) -->
        <file alias="Colors.qml">../qml/Theme/Colors.qml</file>
        <file alias="DataManager.qml">../qml/Theme/DataManager.qml</file>
        <file alias="Utils.qml">../qml/Theme/Utils.qml</file>

        <!-- Pages -->
        <file alias="SecurityDomainForm.qml">../qml/Pages/SecurityDomainForm.qml</file>
        <file alias="SecurityDomainDetail.qml">../qml/Pages/SecurityDomainDetail.qml</file>
        <file alias="InstantiateForm.qml">../qml/Pages/InstantiateForm.qml</file>
        <file alias="SecurityInstanceDetail.qml">../qml/Pages/SecurityInstanceDetail.qml</file>

        <!-- Dialogs -->
        <file alias="AddVisibleUserDialog.qml">../qml/Dialogs/AddVisibleUserDialog.qml</file>
        <file alias="AppWhitelistDetailDialog.qml">../qml/Dialogs/AppWhitelistDetailDialog.qml</file>
        <file alias="CustomerServiceDialog.qml">../qml/Dialogs/CustomerServiceDialog.qml</file>
        <file alias="DeactivateConfirmDialog.qml">../qml/Dialogs/DeactivateConfirmDialog.qml</file>
        <file alias="EncryptFileDialog.qml">../qml/Dialogs/EncryptFileDialog.qml</file>
        <file alias="ExportDetailDialog.qml">../qml/Dialogs/ExportDetailDialog.qml</file>
        <file alias="ExportFileDialog.qml">../qml/Dialogs/ExportFileDialog.qml</file>
        <file alias="ImportFileDialog.qml">../qml/Dialogs/ImportFileDialog.qml</file>
        <file alias="InstanceDetailDialog.qml">../qml/Dialogs/InstanceDetailDialog.qml</file>
        <file alias="InstantiationHelpDialog.qml">../qml/Dialogs/InstantiationHelpDialog.qml</file>
        <file alias="InstantiationPaymentDialog.qml">../qml/Dialogs/InstantiationPaymentDialog.qml</file>
        <file alias="PaymentSuccessDialog.qml">../qml/Dialogs/PaymentSuccessDialog.qml</file>
        <file alias="PausedReminderDialog.qml">../qml/Dialogs/PausedReminderDialog.qml</file>
        <file alias="SetDurationDialog.qml">../qml/Dialogs/SetDurationDialog.qml</file>
        <file alias="UpdateDialog.qml">../qml/Dialogs/UpdateDialog.qml</file>

        <!-- Components -->
        <file alias="BadgeIndicator.qml">../qml/Components/BadgeIndicator.qml</file>
        <file alias="CenteredTooltipText.qml">../qml/Components/CenteredTooltipText.qml</file>
        <file alias="InputContextMenu.qml">../qml/Components/InputContextMenu.qml</file>
        <file alias="MessageCenter.qml">../qml/Components/MessageCenter.qml</file>
        <file alias="OnboardingGuide.qml">../qml/Components/OnboardingGuide.qml</file>
        <file alias="SelectableText.qml">../qml/Components/SelectableText.qml</file>
        <file alias="ShadowBox.qml">../qml/Components/ShadowBox.qml</file>
        <file alias="Sidebar.qml">../qml/Components/Sidebar.qml</file>
        <file alias="PaginationControl.qml">../qml/Components/PaginationControl.qml</file>
        <file alias="EmptyState.qml">../qml/Components/EmptyState.qml</file>
        <file alias="StatusBadge.qml">../qml/Components/StatusBadge.qml</file>

        <!-- Cards (sub-components of SecurityDomainDetail) -->
        <file alias="DomainBasicInfoCard.qml">../qml/Cards/DomainBasicInfoCard.qml</file>
        <file alias="DomainVisibleUsersCard.qml">../qml/Cards/DomainVisibleUsersCard.qml</file>
        <file alias="DomainInstancesCard.qml">../qml/Cards/DomainInstancesCard.qml</file>
        <file alias="DomainWhitelistAuditCard.qml">../qml/Cards/DomainWhitelistAuditCard.qml</file>
        <file alias="DomainExportAuditCard.qml">../qml/Cards/DomainExportAuditCard.qml</file>

        <!-- Logic (JS modules) -->
        <file alias="DomainUtils.js">../qml/Logic/DomainUtils.js</file>
        <file alias="DateTimeUtils.js">../qml/Logic/DateTimeUtils.js</file>

        <!-- Auth -->
        <file alias="CasdoorWebView.qml">../qml/Auth/CasdoorWebView.qml</file>

        <file alias="icons/icon-add-user-blue.svg">../icons/icon-add-user-blue.svg</file>
        <file alias="icons/icon-directory.svg">../icons/icon-directory.svg</file>
        <file alias="icons/icon-domain-instance.svg">../icons/icon-domain-instance.svg</file>
        <file alias="icons/icon-domain-instance-white.svg">../icons/icon-domain-instance-white.svg</file>
        <file alias="icons/icon-dropdown-arrow.svg">../icons/icon-dropdown-arrow.svg</file>
        <file alias="icons/icon-dropdown.svg">../icons/icon-dropdown.svg</file>
        <file alias="icons/icon-edit.svg">../icons/icon-edit.svg</file>
        <file alias="icons/icon-encrypt-to-domain.svg">../icons/icon-encrypt-to-domain.svg</file>
        <file alias="icons/icon-info.svg">../icons/icon-info.svg</file>
        <file alias="icons/icon-warning.svg">../icons/icon-warning.svg</file>
        <file alias="icons/icon-warnning.svg">../icons/icon-warnning.svg</file>
        <file alias="icons/icon-check-success.svg">../icons/icon-check-success.svg</file>
        <file alias="icons/icon-export-upload.svg">../icons/icon-export-upload.svg</file>
        <file alias="icons/SafeLogo.svg">../icons/SafeLogo.svg</file>
        <file alias="icons/icon-security-domain.svg">../icons/icon-security-domain.svg</file>
        <file alias="icons/icon-security-instance.svg">../icons/icon-security-instance.svg</file>
        <file alias="icons/icon-user-avatar.svg">../icons/icon-user-avatar.svg</file>
        <file alias="icons/icon-settings.svg">../icons/icon-settings.svg</file>
        <file alias="icons/icon-bill.svg">../icons/icon-bill.svg</file>
        <file alias="icons/icon-help.svg">../icons/icon-help.svg</file>
        <file alias="icons/icon-error.svg">../icons/icon-error.svg</file>
        <file alias="icons/icon-logout.svg">../icons/icon-logout.svg</file>
        <file alias="icons/icon-message.svg">../icons/icon-message.svg</file>
        <file alias="icons/icon-delete.svg">../icons/icon-delete.svg</file>
        <file alias="icons/icon-import-file.svg">../icons/icon-import-file.svg</file>
        <file alias="icons/icon-export-file.svg">../icons/icon-export-file.svg</file>
        <file alias="icons/icon-check-double.svg">../icons/icon-check-double.svg</file>
        <file alias="icons/icon-update-refresh.svg">../icons/icon-update-refresh.svg</file>
        <file alias="icons/icon-customer-service-white.svg">../icons/icon-customer-service-white.svg</file>
        <file alias="icons/icon-file-generic.svg">../icons/icon-file-generic.svg</file>
        <file alias="icons/icon-empty-state.svg">../icons/icon-empty-state.svg</file>
    </qresource>
</RCC>
