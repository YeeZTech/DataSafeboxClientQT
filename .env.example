# ───────────────────────────────────────────────────────────────
# 敏感配置模板 —— 复制本文件为 test.env 和 prod.env，并填入真实值。
#   test.env  → USE_TEST_ENV=1（测试环境）构建时读取
#   prod.env  → USE_TEST_ENV=0（正式环境）构建时读取
#
# 构建时由 qmake 读取并以编译期宏 DSBOX_<KEY> 注入（见 datasafebox-qt-client.pro）。
# test.env / prod.env 已被 .gitignore 忽略，切勿提交真实密钥到仓库。
# CI 由 GitHub Secrets 自动写入这两个文件，无需提交。
#
# 格式：KEY=VALUE —— 值不要加引号，等号两侧与行内不要有空格。
# ───────────────────────────────────────────────────────────────

# Soketi（消息推送）App Key
SOKETI_APP_KEY=

# Casdoor SSO 客户端 ID（test 与 prod 不同）
CASDOOR_CLIENT_ID=

# 客服聊天（Chatwoot）网站 Token
CUSTOMER_SERVICE_TOKEN=

# Sentry 错误监控 DSN
SENTRY_DSN=
