# ───────────────────────────────────────────────────────────────
# 敏感配置模板 —— 复制本文件为 secrets.env，并填入真实值。
#
# 构建时由 qmake 读取并以编译期宏 DSBOX_<KEY> 注入（见 datasafebox-qt-client.pro）。
# 单一安装包同时内置测试/正式两套服务配置（登录页选择环境），因此
# CASDOOR_CLIENT_ID 需要 test 与 prod 两个值；其余密钥两环境共用。
# secrets.env 已被 .gitignore 忽略，切勿提交真实密钥到仓库。
# CI 由 GitHub Secrets 自动写入该文件，无需提交。
#
# 格式：KEY=VALUE —— 值不要加引号，等号两侧与行内不要有空格。
# ───────────────────────────────────────────────────────────────

# Soketi（消息推送）App Key（两环境共用）
SOKETI_APP_KEY=

# Casdoor SSO 客户端 ID（test 与 prod 不同）
CASDOOR_CLIENT_ID_TEST=
CASDOOR_CLIENT_ID_PROD=

# 客服聊天（Chatwoot）网站 Token（两环境共用）
CUSTOMER_SERVICE_TOKEN=

# Sentry 错误监控 DSN（两环境共用）
SENTRY_DSN=
